PORT=5000
CLIENT_ORIGIN=http://localhost:5173,https://live-score-hub-gold.vercel.app

# ScoreBat token is required even for its free historical video feed.
SCOREBAT_API_TOKEN=
# Use "free" for free-feed; use "paid" only with a plan that grants featured-feed/live-streams access.
SCOREBAT_PLAN=free

# Optional API-Football fallback key. Keep it on the server only.
API_FOOTBALL_KEY=
