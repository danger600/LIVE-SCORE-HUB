PORT=5000
CLIENT_ORIGIN=http://localhost:5173,https://live-score-hub-gold.vercel.app

# Optional ScoreBat developer API token.
# Required for paid featured-feed/live-streams endpoints.
# The free-feed fallback contains selected older videos, not current live matches.
SCOREBAT_API_TOKEN=

# Optional API-Football fallback key. Keep it on the server only.
API_FOOTBALL_KEY=
