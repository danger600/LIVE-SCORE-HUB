PORT=5000
CLIENT_ORIGIN=http://localhost:5173,https://live-score-hub-gold.vercel.app

# API-Football (API-Sports) - obtain your key from https://dashboard.api-football.com/
API_FOOTBALL_KEY=

# ScoreBat - token required even for the free historical feed.
SCOREBAT_API_TOKEN=
# "free" uses free-feed; "paid" uses featured-feed and enables live-streams.
SCOREBAT_PLAN=free

# SportScore public feed requires no key on its documented public tier.
# The frontend must retain the required visible SportScore attribution.

# Set true only after a licensed broadcast partner and distribution rights are configured.
LICENSED_STREAMS_CONFIGURED=false
